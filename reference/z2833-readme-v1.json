{
  "openapi": "3.0.3",
  "info": {
    "title": "Z2833 ReadMe Changelogs API",
    "version": "1.0.0",
    "description": "F129e PoC - customer documents ReadMe API v1 changelogs (benign)."
  },
  "servers": [
    {
      "url": "https://dash.readme.com/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/changelogs": {
      "get": {
        "operationId": "z2833ListChangelogs",
        "summary": "List changelogs",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/changelogs/{slug}": {
      "parameters": [
        {
          "name": "slug",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "z2833GetChangelog",
        "summary": "Get changelog",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "put": {
        "operationId": "z2833UpdateChangelog",
        "summary": "Update changelog",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "hidden": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  }
}