{
  "openapi": "3.1.0",
  "info": {
    "title": "Z3643-CANARY-PRIVATE-SPEC",
    "version": "1.0.0",
    "description": "This spec contains Z3643-CANARY-SECRET-DATA that should only be visible to authenticated users. If you can read this via MCP without signing in, the OAuth gate is bypassed."
  },
  "servers": [
    {
      "url": "https://httpbin.org"
    }
  ],
  "paths": {
    "/z3643-private-endpoint": {
      "get": {
        "operationId": "getCanaryData",
        "summary": "Z3643-CANARY-PRIVATE-ENDPOINT returns secret data",
        "security": [
          {
            "z3643prov": [
              "read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Z3643-CANARY-RESPONSE containing private information"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "z3643prov": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://httpbin.org/z3643-auth",
            "tokenUrl": "https://httpbin.org/z3643-token",
            "scopes": {
              "read": "Read access"
            }
          }
        }
      }
    }
  }
}